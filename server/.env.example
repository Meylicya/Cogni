# Sample .env for the Cogni server. Copy to `.env` and fill in real values.
# `.env` is gitignored; never commit it.

MONGO_URI=

# Gmail credentials used by server/utils/mailer.js to send invites.
EMAIL_USER=
EMAIL_PASS=

# HACKATHON_DEMO=1 turns on the /api/demo/* routes in server/index.js.
# They seed a demo clinician/patient/caregiver with a known password
# and let the LandingPage's "Hackathon Demo" buttons auto-login.
# MUST also be off NODE_ENV=production (the route 404s in prod anyway).
# Flip to "0" (or remove) for any non-demo deploy.
HACKATHON_DEMO=1
